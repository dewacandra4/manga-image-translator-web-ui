# ============================================================================
#  Environment variables for manga-image-translator-web-ui
# ----------------------------------------------------------------------------
#  Usage:
#    1. Copy this file to ".env"   ->   cp env.example .env
#    2. Fill in the values you need (leave the rest blank/default).
#    3. The app loads ".env" automatically via python-dotenv on startup.
#
#  NOTE: ".env" is gitignored — never commit real secrets. Keep them here
#        only as empty placeholders.
# ============================================================================

# ----------------------------------------------------------------------------
#  API Authentication (web server middleware)
# ----------------------------------------------------------------------------
#  Protects ALL web endpoints. When BOTH values are set, every request must
#  send matching credentials via either:
#    - X-Client-Id / X-Client-Secret            (custom headers), or
#    - CF-Access-Client-Id / CF-Access-Client-Secret  (Cloudflare Access)
#  If left blank, authentication is DISABLED (all requests pass through).
API_CLIENT_ID=
API_CLIENT_SECRET=

# ----------------------------------------------------------------------------
#  OpenAI / ChatGPT translator
# ----------------------------------------------------------------------------
OPENAI_API_KEY=
# Override the API base URL (e.g. a proxy or self-hosted OpenAI-compatible API)
OPENAI_API_BASE=https://api.openai.com/v1
# Optional HTTP proxy for OpenAI requests
OPENAI_HTTP_PROXY=

# ----------------------------------------------------------------------------
#  Sakura translator (local LLM)
# ----------------------------------------------------------------------------
SAKURA_API_BASE=http://127.0.0.1:8080/v1
# API version: 0.9 or 0.10 (0.10 loads the glossary/term dictionary)
SAKURA_VERSION=0.9
SAKURA_DICT_PATH=./sakura_dict.txt

# ----------------------------------------------------------------------------
#  DeepL translator
# ----------------------------------------------------------------------------
DEEPL_AUTH_KEY=

# ----------------------------------------------------------------------------
#  Baidu translator
# ----------------------------------------------------------------------------
BAIDU_APP_ID=
BAIDU_SECRET_KEY=

# ----------------------------------------------------------------------------
#  Youdao translator
# ----------------------------------------------------------------------------
YOUDAO_APP_KEY=
YOUDAO_SECRET_KEY=

# ----------------------------------------------------------------------------
#  Caiyun translator
# ----------------------------------------------------------------------------
CAIYUN_TOKEN=

# ----------------------------------------------------------------------------
#  Internal / advanced (usually leave as default)
# ----------------------------------------------------------------------------
# Secret for securing internal web-server communication.
# Auto-generated at runtime if left blank.
MT_WEB_NONCE=
# Secret for the internal websocket connection (worker <-> server).
WS_SECRET=
# Inpainting compute precision: fp32 | fp16 | bf16
INPAINTING_PRECISION=fp32
